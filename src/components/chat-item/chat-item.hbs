{{{Avatar}}}

<div class='{{styles.body}}'>
  <div class='{{styles.group}}'>
    <h3 class='{{styles.displayName}}'>
      {{chat.title}}
    </h3>

    <time class='{{styles.time}}'>
      {{time}}
    </time>
  </div>
  <div class='{{styles.group}}'>
    <p class='{{styles.message}}'>
      {{#if owner}}
      <span class='{{styles.owner}}'>
        {{owner}}:
      </span>
    {{/if}}
      {{message}}
    </p>

    {{#if (neq unread 0)}}
      <p class='{{styles.badge}}'>
        {{unread}}
      </p>
    {{/if}}
  </div>
</div>
