<div class='{{styles.group}}'>
  {{{Avatar}}}
  <div class='{{styles.textGroup}}'>
    <p class='{{styles.nameP}}'>
      <span class='{{styles.name}}'>
        {{first_name}}
      </span>
      <span class='{{styles.name}}'>
        {{second_name}}
      </span>
    </p>
    <p class='{{styles.loginP}}'>
      <span class='{{styles.accent}}'>
        @
      </span>
      <span class='{{styles.login}}'>
        {{login}}
      </span>
    </p>
  </div>
</div>
<div class='{{styles.btn}}'>
  {{#if currentUser}}
    Me
  {{else}}
    {{{ActionButton}}}
  {{/if}}
</div>
